<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03_mysql_a_parquet</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Exporta la tabla limpia imdb_clean_final de MySQL al Parquet de staging.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/21 23:10:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/21 23:10:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>01 Leer tabla limpia</from>
      <to>02 Guardar Parquet</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>TableInput</type>
    <name>01 Leer tabla limpia</name>
    <sql>SELECT tconst, title, title_key, startYear, genres, averageRating, numVotes
FROM imdb_clean_final</sql>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>imdb_mysql</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>112</yloc>
    </GUI>
    <description>Lee las 334.067 filas limpias desde MySQL.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileOutput</type>
    <name>02 Guardar Parquet</name>
    <filename_base>C:/Users/diego/Downloads/apachehopETL/staging/imdb_clean</filename_base>
    <filename_ext>parquet</filename_ext>
    <filename_include_date>N</filename_include_date>
    <filename_include_time>N</filename_include_time>
    <filename_include_datetime>N</filename_include_datetime>
    <filename_datetime_format>yyyyMMdd-HHmmss</filename_datetime_format>
    <filename_include_copy>N</filename_include_copy>
    <filename_include_split>N</filename_include_split>
    <filename_split_size>1000000</filename_split_size>
    <filename_create_parent_folders>Y</filename_create_parent_folders>
    <filename_compression_before_extension>N</filename_compression_before_extension>
    <compression_codec>UNCOMPRESSED</compression_codec>
    <version>2.0</version>
    <row_group_size>268435456</row_group_size>
    <data_page_size>8192</data_page_size>
    <dictionary_page_size>1048576</dictionary_page_size>
    <fields><field><source_field>tconst</source_field>
<target_field>tconst</target_field>
</field><field><source_field>title</source_field>
<target_field>title</target_field>
</field><field><source_field>title_key</source_field>
<target_field>title_key</target_field>
</field><field><source_field>startYear</source_field>
<target_field>startYear</target_field>
</field><field><source_field>genres</source_field>
<target_field>genres</target_field>
</field><field><source_field>averageRating</source_field>
<target_field>averageRating</target_field>
</field><field><source_field>numVotes</source_field>
<target_field>numVotes</target_field>
</field></fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>400</xloc>
      <yloc>112</yloc>
    </GUI>
    <description>Genera staging/imdb_clean.parquet desde la tabla limpia.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
</pipeline>
